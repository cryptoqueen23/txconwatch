    :host {
      --rosie-primary: #2DD4BF;
      --rosie-primary-dark: #26B8A5;
      --rosie-primary-text: #000000;
      --rosie-text: #171717;
      --rosie-text-secondary: #404040;
      --rosie-text-light: #6B7280;
      --rosie-text-muted: #A89FB3;
      --rosie-bg: #FFFFFF;
      --rosie-border: #E5E7EB;
      --rosie-error: #EF4444;
      --rosie-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
      --rosie-shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.1);
      --rosie-font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      
      font-family: var(--rosie-font);
      font-size: 14px;
      line-height: 1.5;
      box-sizing: border-box;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    .widget-container {
      position: fixed;
      z-index: 999999;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 17px;
    }

    .widget-container.bottom-right {
      bottom: 20px;
      right: 20px;
    }

    .widget-container.bottom-left {
      bottom: 20px;
      left: 20px;
      align-items: flex-start;
    }

    /* ==================== MINIMIZED BUTTON ==================== */
    .minimized-button {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-width: 100px;
      padding: 6px 20px 6px 6px;
      background: var(--rosie-primary);
      color: var(--rosie-primary-text);
      border: none;
      border-radius: 50px;
      cursor: pointer;
      font-family: var(--rosie-font);
      font-size: 14px;
      font-weight: 600;
      line-height: 20px;
      letter-spacing: -0.14px;
      box-shadow: var(--rosie-shadow-sm);
      transition: all 0.2s ease;
    }

    .minimized-button:hover {
      background: var(--rosie-primary-dark);
      transform: translateY(-2px);
      box-shadow: var(--rosie-shadow);
    }

    .minimized-button .icon-wrapper {
      position: relative;
      display: flex;
      width: 32px;
      height: 32px;
      justify-content: center;
      align-items: center;
      border-radius: 99px;
      background: rgba(0, 0, 0, 0.08);
    }

    .minimized-button svg {
      width: 20px;
      height: 20px;
    }

    .notification-badge {
      position: absolute;
      top: -3px;
      right: -4px;
      width: 14px;
      height: 14px;
      background: #EF4444;
      border-radius: 99px;
      border: 1px solid #FFF;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .notification-badge svg {
      width: 5px;
      height: 8px;
    }

    /* ==================== INITIAL POPUP ==================== */
    .initial-popup {
      position: relative;
      background: var(--rosie-bg);
      border-radius: 16px;
      border: 1px solid #E9E7ED;
      box-shadow: var(--rosie-shadow);
      width: 202px;
      padding: 16px 15px 24px 15px;
      animation: slideUp 0.3s ease;
    }

    .initial-popup::before {
      content: '';
      position: absolute;
      bottom: -9px;
      right: 26px;
      width: 0;
      height: 0;
      border-left: 9px solid transparent;
      border-right: 9px solid transparent;
      border-top: 9px solid #E9E7ED;
    }

    .initial-popup::after {
      content: '';
      position: absolute;
      bottom: -8px;
      right: 27px;
      width: 0;
      height: 0;
      border-left: 8px solid transparent;
      border-right: 8px solid transparent;
      border-top: 8px solid var(--rosie-bg);
    }

    .initial-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 8px;
    }

    .initial-avatar {
      position: relative;
      display: flex;
      width: 40px;
      height: 40px;
      justify-content: flex-end;
      align-items: flex-end;
      flex-shrink: 0;
    }

    .initial-avatar img,
    .initial-avatar .avatar-placeholder {
      width: 40px;
      height: 40px;
      border-radius: 200px;
      border: 1px solid rgba(0, 0, 0, 0.08);
      object-fit: cover;
      background-color: #CBD5E1;
    }

    .avatar-placeholder {
      background: #CBD5E1;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--rosie-text-light);
    }

    .avatar-placeholder svg {
      width: 20px;
      height: 20px;
    }

    .online-dot {
      position: absolute;
      bottom: 0px;
      right: 0px;
      width: 10px;
      height: 10px;
      background: #17B26A;
      border: 1.5px solid #FFF;
      border-radius: 5px;
      flex-shrink: 0;
    }

    .initial-close {
      background: none;
      border: none;
      cursor: pointer;
      color: var(--rosie-text-muted);
      padding: 0;
      margin: 0;
      border-radius: 4px;
      transition: color 0.2s;
      line-height: 0;
    }

    .initial-close:hover {
      color: var(--rosie-text-secondary);
    }

    .initial-close svg {
      width: 16px;
      height: 16px;
      display: block;
    }

    .initial-content {
      margin-top: 12px;
    }

    .initial-greeting {
      font-family: var(--rosie-font);
      font-size: 18px;
      font-weight: 600;
      line-height: 21px;
      letter-spacing: -0.18px;
      color: var(--rosie-text);
      margin: 0 0 12px 0;
    }

    .initial-subtitle {
      font-family: var(--rosie-font);
      font-size: 12px;
      font-weight: 700;
      line-height: 16px;
      letter-spacing: -0.12px;
      color: var(--rosie-text-secondary);
      margin: 0 0 4px 0;
    }

    .initial-description {
      font-family: var(--rosie-font);
      font-size: 12px;
      font-weight: 500;
      line-height: 16px;
      letter-spacing: -0.12px;
      color: var(--rosie-text-secondary);
      margin: 0;
    }

    .initial-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      width: 100%;
      padding: 8px 14px;
      background: var(--rosie-text);
      color: #FFF;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-family: var(--rosie-font);
      font-size: 14px;
      font-weight: 600;
      line-height: 20px;
      letter-spacing: -0.14px;
      margin-top: 12px;
      transition: background 0.2s;
    }

    .initial-cta:hover {
      background: #374151;
    }

    .initial-cta svg {
      width: 20px;
      height: 20px;
    }

    /* ==================== FORM POPUP ==================== */
    .form-popup {
      background: var(--rosie-bg);
      border-radius: 12px;
      box-shadow: var(--rosie-shadow);
      width: 330px;
      overflow: hidden;
      animation: slideUp 0.3s ease;
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .form-header {
      background: var(--rosie-primary);
      padding: 12px;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .form-header-avatar {
      position: relative;
      display: flex;
      width: 40px;
      height: 40px;
      justify-content: flex-end;
      align-items: flex-end;
      flex-shrink: 0;
    }

    .form-header-avatar img,
    .form-header-avatar .avatar-placeholder {
      width: 40px;
      height: 40px;
      border-radius: 200px;
      border: 1px solid rgba(0, 0, 0, 0.08);
      object-fit: cover;
      background-color: #CBD5E1;
    }

    .form-header-avatar .avatar-placeholder {
      background: #CBD5E1;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--rosie-text-light);
    }

    .form-header-avatar .online-dot {
      width: 10px;
      height: 10px;
      border: 1.5px solid #FFF;
    }

    .form-header-title {
      flex: 1;
      font-family: var(--rosie-font);
      font-size: 14px;
      font-weight: 700;
      line-height: 21px;
      letter-spacing: -0.14px;
      color: var(--rosie-primary-text);
      margin: 0;
    }

    .form-header-close {
      background: none;
      border: none;
      cursor: pointer;
      color: var(--rosie-primary-text);
      padding: 4px;
      border-radius: 4px;
      opacity: 0.8;
      transition: opacity 0.2s;
      line-height: 0;
    }

    .form-header-close:hover {
      opacity: 1;
    }

    .form-header-close svg {
      width: 16px;
      height: 16px;
      display: block;
    }

    .form-content {
      overflow: hidden;
      background: linear-gradient(180deg, #FAFAFA 0%, #F4F4F5 100%);
      border: 1px solid #E9E7ED;
      border-top: none;
      border-radius: 0 0 12px 12px;
    }

    .form-body {
      padding: 16px;
      background: var(--rosie-bg);
      border-bottom: 1px solid #E9E7ED;
      border-top: none;
      border-radius: 0 0 12px 12px;
    }

    .form-greeting {
      font-family: var(--rosie-font);
      font-size: 14px;
      font-weight: 600;
      line-height: 20px;
      letter-spacing: -0.14px;
      color: #404040;
      margin: 0 0 4px 0;
    }

    .form-description {
      font-family: var(--rosie-font);
      font-size: 14px;
      font-weight: 600;
      line-height: 20px;
      letter-spacing: -0.14px;
      color: #404040;
      margin: 0 0 16px 0;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .input-wrapper {
      position: relative;
      display: flex;
      width: 100%;
      height: 44px;
      padding: 8px;
      align-items: center;
      gap: 8px;
      border-radius: 8px;
      border: 1px solid #A3A3A3;
      background: #FFF;
      transition: border-color 0.2s;
    }


    .input-wrapper.error {
      border-radius: 8px;
      border: 1px solid #FB7185;
      background: #FFF;
    }

    .input-wrapper.error:focus-within {
      border: 1px solid #FB7185;
      box-shadow: 0 0 0 3px rgba(251, 113, 133, 0.15);
    }

    .input-icon {
      color: #737373;
      pointer-events: none;
      line-height: 0;
      flex-shrink: 0;
    }

    .input-icon svg {
      width: 24px;
      height: 24px;
      display: block;
    }

    .input-content {
      flex: 1;
      position: relative;
      min-width: 0;
      height: 100%;
      display: flex;
      align-items: center;
    }

    .input-label {
      font-family: var(--rosie-font);
      font-size: 14px;
      font-weight: 500;
      line-height: 20px;
      letter-spacing: -0.14px;
      color: #737373;
      transition: all 0.15s ease;
      pointer-events: none;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      left: 0;
    }

    .input-content.has-value .input-label,
    .input-content.focused .input-label {
      font-size: 10px;
      font-weight: 500;
      line-height: 10px;
      letter-spacing: -0.1px;
      top: 0px;
      transform: translateY(0);
    }

    .form-input {
      width: 100%;
      border: none;
      background: transparent;
      font-family: var(--rosie-font);
      font-size: 14px;
      font-weight: 500;
      line-height: 20px;
      letter-spacing: -0.14px;
      color: var(--rosie-text);
      outline: none;
      padding: 0;
      padding-top: 14px;
    }

    .field-error {
      color: #E11D48;
      font-family: var(--rosie-font);
      font-size: 10px;
      font-style: normal;
      font-weight: 500;
      line-height: 16px;
      letter-spacing: -0.1px;
      margin-top: 6px;
    }

    .submit-button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      width: 100%;
      padding: 10px 14px;
      background: var(--rosie-primary);
      color: var(--rosie-primary-text);
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-family: var(--rosie-font);
      font-size: 14px;
      font-weight: 600;
      line-height: 20px;
      letter-spacing: -0.14px;
      transition: background 0.2s;
    }

    .submit-button:hover:not(:disabled) {
      background: var(--rosie-primary-dark);
    }

    .submit-button:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }

    .submit-button svg {
      width: 20px;
      height: 20px;
    }

    .spinner {
      width: 20px;
      height: 20px;
      border: 2px solid currentColor;
      border-top-color: transparent;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      opacity: 0.8;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .legal-text {
      font-family: var(--rosie-font);
      font-size: 8px;
      font-weight: 500;
      line-height: 11px;
      letter-spacing: -0.08px;
      color: #737373;
      margin-top: 16px;
      margin-bottom: 3px;
    }

    .legal-text a {
      color: #737373;
      text-decoration: underline;
    }

    .form-footer {
      text-align: center;
      padding: 10px 12px;
    }

    .powered-by {
      font-family: var(--rosie-font);
      font-size: 10px;
      font-weight: 500;
      line-height: 16px;
      letter-spacing: -0.1px;
      color: #A3A3A3;
    }

    .powered-by a {
      color: #A3A3A3;
      text-decoration: underline;
      font-weight: 500;
    }

    /* ==================== SUCCESS STATE ==================== */
    .success-content {
      padding: 30px 48px 38px 48px;
      text-align: center;
      background: var(--rosie-bg);
      border-top: none;
      border-bottom: 1px solid #E9E7ED;
      border-radius: 0 0 12px 12px;
    }

    .success-icon {
      width: 52px;
      height: 52px;
      background: #A7F3D0;
      border-radius: 99px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      gap: 8px;
      margin: 0 auto 14px;
    }

    .success-icon svg {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    .success-title {
      font-family: var(--rosie-font);
      font-size: 14px;
      font-style: normal;
      font-weight: 700;
      line-height: 21px;
      letter-spacing: -0.14px;
      color: #000;
      text-align: center;
      margin: 0 0 15px 0;
    }

    .success-message {
      font-family: var(--rosie-font);
      font-size: 14px;
      font-style: normal;
      font-weight: 600;
      line-height: 20px;
      letter-spacing: -0.14px;
      color: #404040;
      text-align: center;
      margin: 0;
    }

    /* ==================== CLOSE BUTTON (BLACK CIRCLE) ==================== */
    .close-fab {
      width: 48px;
      height: 48px;
      background: var(--rosie-text);
      color: white;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--rosie-shadow-sm);
      transition: all 0.2s;
    }

    .close-fab:hover {
      background: #374151;
      transform: scale(1.05);
    }

    .close-fab svg {
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }

    /* ==================== CHAT MODE ==================== */
    .initial-cta.chat-cta {
      background: var(--rosie-primary);
      color: var(--rosie-primary-text);
    }

    .initial-cta.chat-cta:hover {
      background: var(--rosie-primary-dark);
    }

    .chat-body {
      display: flex;
      flex-direction: column;
      background: var(--rosie-bg);
      border-bottom: 1px solid #E9E7ED;
      border-radius: 0 0 12px 12px;
    }

    .chat-messages {
      display: flex;
      flex-direction: column;
      gap: 12px;
      height: 320px;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 16px 12px;
    }

    .chat-date-divider {
      font-family: var(--rosie-font);
      font-size: 12px;
      font-weight: 500;
      line-height: 16px;
      letter-spacing: -0.12px;
      color: #737373;
      text-align: center;
      margin: 0 0 4px 0;
    }

    .chat-row {
      display: flex;
      align-items: flex-end;
      gap: 8px;
    }

    .chat-row.user {
      justify-content: flex-end;
    }

    .chat-row-avatar img,
    .chat-row-avatar .avatar-placeholder {
      width: 32px;
      height: 32px;
      border-radius: 200px;
      border: 1px solid rgba(0, 0, 0, 0.08);
      object-fit: cover;
      background-color: #CBD5E1;
      flex-shrink: 0;
    }

    .chat-row-avatar .avatar-placeholder svg {
      width: 16px;
      height: 16px;
    }

    .chat-bubble {
      max-width: 80%;
      padding: 10px 14px;
      border-radius: 16px;
      font-family: var(--rosie-font);
      font-size: 14px;
      font-weight: 500;
      line-height: 20px;
      letter-spacing: -0.14px;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .chat-bubble.agent {
      background: #F2F1F4;
      color: var(--rosie-text);
      border-bottom-left-radius: 4px;
    }

    .chat-bubble.user {
      background: var(--rosie-primary);
      color: var(--rosie-primary-text);
      border-bottom-right-radius: 4px;
    }

    .chat-bubble .chat-link {
      color: inherit;
      text-decoration: underline;
      font-weight: 600;
    }

    .chat-system-note {
      font-family: var(--rosie-font);
      font-size: 12px;
      font-weight: 500;
      line-height: 16px;
      letter-spacing: -0.12px;
      color: #737373;
      text-align: center;
      margin: 4px 0;
    }

    .typing-bubble {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: #F2F1F4;
      border-radius: 16px;
      border-bottom-left-radius: 4px;
      padding: 14px;
    }

    .typing-bubble span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #A3A3A3;
      animation: typingPulse 1.2s infinite ease-in-out;
    }

    .typing-bubble span:nth-child(2) {
      animation-delay: 0.2s;
    }

    .typing-bubble span:nth-child(3) {
      animation-delay: 0.4s;
    }

    @keyframes typingPulse {
      0%, 60%, 100% { opacity: 0.35; transform: translateY(0); }
      30% { opacity: 1; transform: translateY(-3px); }
    }

    .chat-input-row {
      display: flex;
      align-items: flex-end;
      gap: 10px;
      padding: 12px;
      border-top: 1px solid #E9E7ED;
      background: var(--rosie-bg);
    }

    .chat-input {
      flex: 1;
      border: none;
      background: transparent;
      outline: none;
      font-family: var(--rosie-font);
      font-size: 14px;
      font-weight: 500;
      line-height: 20px;
      letter-spacing: -0.14px;
      color: var(--rosie-text);
      padding: 8px 4px;
      resize: none;
      max-height: 96px;
      overflow-y: auto;
    }

    .chat-input::placeholder {
      color: #A3A3A3;
    }

    .chat-send-button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      flex-shrink: 0;
      background: var(--rosie-primary);
      color: var(--rosie-primary-text);
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .chat-send-button:hover:not(:disabled) {
      background: var(--rosie-primary-dark);
    }

    .chat-send-button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .chat-send-button svg {
      width: 22px;
      height: 22px;
    }

    /* ==================== PREVIEW / TEST MODE ==================== */
    :host([preview]) .widget-container,
    :host([test-mode]) .widget-container {
      position: relative;
      bottom: auto;
      left: auto;
      right: auto;
      z-index: 1;
    }

    :host([preview]) .widget-container.bottom-left,
    :host([test-mode]) .widget-container.bottom-left {
      align-items: flex-start;
    }

    :host([preview]) .widget-container.bottom-left .initial-popup::before,
    :host([test-mode]) .widget-container.bottom-left .initial-popup::before {
      right: auto;
      left: 26px;
    }

    :host([preview]) .widget-container.bottom-left .initial-popup::after,
    :host([test-mode]) .widget-container.bottom-left .initial-popup::after {
      right: auto;
      left: 27px;
    }
  `,d.STORAGE_KEY="rosie-widget-minimized",d.DEFAULT_CONFIG={businessId:"",businessName:"Our Team",primaryColor:"#2DD4BF",avatar:"https://assets.heyrosie.com/avatars/placeholder.png",greetingMessage:"Welcome to :business_name. Text us now for immediate response.",position:"bottom-right",enabled:!0,type:"sms",websocket:null,widgetOpenMode:"immediately",widgetOpenDelay:5},d.CHAT_DEFAULT_GREETING="Ask us anything — we reply instantly.",u([w({type:String,attribute:"business-id"})],d.prototype,"businessId",void 0),u([w({type:String,attribute:"api-url"})],d.prototype,"apiUrl",void 0),u([w({type:Boolean})],d.prototype,"debug",void 0),u([w({type:Boolean})],d.prototype,"preview",void 0),u([w({type:Boolean,attribute:"test-mode"})],d.prototype,"testMode",void 0),u([w({type:String,attribute:"primary-color"})],d.prototype,"primaryColorOverride",void 0),u([w({type:String,attribute:"avatar-url"})],d.prototype,"avatarOverride",void 0),u([w({type:String,attribute:"greeting-message"})],d.prototype,"greetingMessageOverride",void 0),u([w({type:Boolean,attribute:"wl"})],d.prototype,"hideBranding",void 0),u([w({type:String,attribute:"position"})],d.prototype,"positionOverride",void 0),u([w({type:String,attribute:"business-name"})],d.prototype,"businessNameOverride",void 0),u([w({type:Boolean,attribute:"widget-enabled"})],d.prototype,"enabledOverride",void 0),u([w({type:String,attribute:"widget-type"})],d.prototype,"widgetTypeOverride",void 0),u([w({type:String,attribute:"widget-open-mode"})],d.prototype,"widgetOpenModeOverride",void 0),u([w({type:String,attribute:"widget-state"})],d.prototype,"widgetStateOverride",void 0),u([_()],d.prototype,"_widgetState",void 0),u([_()],d.prototype,"config",void 0),u([_()],d.prototype,"phoneNumber",void 0),u([_()],d.prototype,"customerName",void 0),u([_()],d.prototype,"isLoading",void 0),u([_()],d.prototype,"phoneError",void 0),u([_()],d.prototype,"nameError",void 0),u([_()],d.prototype,"configLoaded",void 0),u([_()],d.prototype,"nameFocused",void 0),u